:root {
    --ink: #3B2A1A;
    --paper: #FCF4E3;
    --paper-edge: #E3CFA6;
    --wood: #8A6A45;
    --rose: #D6336C;
    --rose-deep: #A3204F;
    --gold: #F2B233;
    --gold-deep: #A96A00;
    --jade: #1F7A6D;
    --jade-deep: #155A50;
    --p1: #E94F4F;
    --p2: #3D8BFF;
    --p3: #3CC57A;
    --p4: #FFC23D;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/MaliBoldSDF.asset");
    color: var(--ink);
}

/* Unity's default theme stretches this root; this project uses its own theme instead. */
.unity-ui-document__root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.player--p1 { --player: var(--p1); }
.player--p2 { --player: var(--p2); }
.player--p3 { --player: var(--p3); }
.player--p4 { --player: var(--p4); }

.app {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.safe-area {
    position: absolute;
}

.btn {
    margin: 0;
    padding: 18px 44px;
    border-width: 0;
    border-bottom-width: 9px;
    border-radius: 30px;
    background-color: var(--paper);
    border-bottom-color: var(--paper-edge);
    color: var(--ink);
    font-size: 40px;
    -unity-text-align: middle-center;
    transition-property: translate, scale, opacity;
    transition-duration: 90ms, 90ms, 200ms;
}

.btn:active {
    translate: 0 5px;
    scale: 0.98 0.98;
}

.btn--primary {
    background-color: var(--jade);
    border-bottom-color: var(--jade-deep);
    color: var(--paper);
}

.btn--accent {
    background-color: var(--gold);
    border-bottom-color: var(--gold-deep);
}

/* Inset past the screen so the results blur has no dark edge. */
.field {
    position: absolute;
    left: -24px;
    right: -24px;
    top: -24px;
    bottom: -24px;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: filter;
    transition-duration: 300ms;
}

/* Filters render the subtree to a texture, so this applies only once the action has stopped. */
.is-finished .field,
.is-finished .stage {
    filter: blur(6px) grayscale(0.35);
}

.seat {
    width: 170px;
    height: 170px;
    margin-left: -85px;
    margin-top: -85px;
}

.seat-ring {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: 13px;
    border-radius: 85px;
    border-color: var(--player);
}

.seat-disc {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 85px;
    background-color: var(--player);
    align-items: center;
    justify-content: center;
}

.seat-label {
    margin: 0;
    padding: 0;
    font-size: 48px;
}

.seat-feedback,
.seat-chant {
    position: absolute;
    left: -115px;
    width: 400px;
    height: 80px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.seat-feedback {
    top: -145px;
    font-size: 46px;
    opacity: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--paper);
}

.seat-chant {
    top: -215px;
    font-size: 56px;
    opacity: 0;
}

.seat--duel .seat-feedback {
    left: 115px;
    top: 5px;
}

.seat--duel .seat-chant {
    left: 115px;
    top: -65px;
}

.feedback--perfect {
    color: var(--gold-deep);
}

.feedback--good {
    color: var(--ink);
}

.feedback--miss {
    color: var(--wood);
}

.feedback--sync {
    color: var(--rose-deep);
}

.timer {
    position: absolute;
    left: 50%;
    top: 26px;
    width: 150px;
    height: 94px;
    margin: 0 0 0 -75px;
    padding: 0;
    border-radius: 47px;
    background-color: var(--paper);
    font-size: 60px;
    -unity-text-align: middle-center;
}

.timer--final {
    color: var(--rose-deep);
}

.center-message {
    position: absolute;
    left: 0;
    right: 0;
    top: 16%;
    margin: 0;
    padding: 0;
    font-size: 116px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--paper);
}

.toggle-players {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 420px;
    margin-left: -210px;
    padding: 12px 20px;
    font-size: 32px;
}

.results {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(59, 42, 26, 0.32);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 220ms;
}

.results.is-in {
    opacity: 1;
}

.results-card {
    width: 1040px;
    padding: 36px 64px 40px 64px;
    border-radius: 44px;
    border-bottom-width: 12px;
    border-bottom-color: var(--paper-edge);
    background-color: var(--paper);
    align-items: center;
    scale: 0.88 0.88;
    transition-property: scale;
    transition-duration: 360ms;
    transition-timing-function: ease-out-back;
}

.results.is-in .results-card {
    scale: 1 1;
}

.result-title {
    margin: 0;
    padding: 0;
    font-size: 92px;
    -unity-text-align: middle-center;
}

.result-fact {
    margin: 12px 0 28px 0;
    padding: 0;
    min-height: 84px;
    font-size: 30px;
    color: var(--wood);
    white-space: normal;
    -unity-text-align: middle-center;
}

.result-actions {
    flex-direction: row;
    justify-content: center;
}

.result-button {
    width: 340px;
    margin: 0 14px;
}
