<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Template src="../ResultsOverlay.uxml" name="ResultsOverlay" />
  <ui:Style src="KeoCoHud.uss" />
  <ui:VisualElement name="keoCoHud" class="app" picking-mode="Ignore">
    <ui:VisualElement name="field" class="field keoco-field" picking-mode="Ignore">
      <ui:VisualElement class="center-line" picking-mode="Ignore" />
      <ui:VisualElement class="win-line win-line--left" picking-mode="Ignore" />
      <ui:VisualElement class="win-line win-line--right" picking-mode="Ignore" />
      <ui:VisualElement name="rope" class="rope" picking-mode="Ignore">
        <ui:VisualElement class="ribbon" picking-mode="Ignore" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="seatLayer" class="safe-area" picking-mode="Ignore" />
    <ui:Label name="timer" class="timer" picking-mode="Ignore" />
    <ui:Label name="centerMessage" class="center-message" picking-mode="Ignore" />
    <ui:Button name="togglePlayers" class="btn toggle-players" />
    <ui:Instance template="ResultsOverlay" class="app" picking-mode="Ignore" />
  </ui:VisualElement>
</ui:UXML>
