/* The rope runs along the ground, below the horizon of the background. */
.center-line {
    position: absolute;
    left: 50%;
    top: 68%;
    width: 6px;
    height: 200px;
    margin-left: -3px;
    margin-top: -100px;
    background-color: var(--paper);
    opacity: 0.4;
}

/* 560px must match TrackHalfWidth in KeoCoGame.cs. */
.win-line {
    position: absolute;
    left: 50%;
    top: 68%;
    width: 10px;
    height: 260px;
    margin-left: -5px;
    margin-top: -130px;
    border-radius: 5px;
    background-color: var(--paper);
}

.win-line--left {
    translate: -560px 0;
}

.win-line--right {
    translate: 560px 0;
}

/* The ribbon is part of the art, at its exact center, so the rope's translate moves it. */
.rope {
    position: absolute;
    left: 50%;
    top: 68%;
    width: 1100px;
    height: 57px;
    margin-left: -550px;
    margin-top: -28px;
    background-image: url("project://database/Assets/UI%20Assets/Tug%20of%20War.png?fileID=5727035119651369238&guid=555ff159367b14142ab060ce45c062f3&type=3#Tug%20of%20War_0");
}

/* The hands, 38% up the character, sit on the rope. */
.rope .puller {
    left: 50%;
    top: 50%;
    margin-left: -85px;
    margin-top: -130px;
    scale: 1.15 1.15;
}
