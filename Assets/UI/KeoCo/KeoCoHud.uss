.keoco-field {
    background-image: url("project://database/Assets/UI/Art/keoco-field.svg");
}

.center-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 420px;
    margin-left: -3px;
    margin-top: -210px;
    background-color: var(--wood);
    opacity: 0.4;
}

/* 560px must match TrackHalfWidth in KeoCoGame.cs. */
.win-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 520px;
    margin-left: -5px;
    margin-top: -260px;
    border-radius: 5px;
    background-color: var(--wood);
}

.win-line--left {
    translate: -560px 0;
}

.win-line--right {
    translate: 560px 0;
}

.rope {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1100px;
    height: 18px;
    margin-left: -550px;
    margin-top: -9px;
    border-radius: 9px;
    background-color: #9C6B3A;
}

.ribbon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30px;
    height: 90px;
    margin-left: -15px;
    margin-top: -45px;
    border-radius: 8px;
    background-color: var(--rose);
}

.puller {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100px;
    height: 100px;
    margin-left: -50px;
    margin-top: -50px;
    border-radius: 50px;
    border-width: 5px;
    border-color: var(--paper);
    background-color: var(--player);
    align-items: center;
    justify-content: center;
}

.puller Label {
    margin: 0;
    padding: 0;
    font-size: 34px;
}
