<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Template src="../ResultsOverlay.uxml" name="ResultsOverlay" />
  <ui:Template src="../PauseOverlay.uxml" name="PauseOverlay" />
  <ui:Style src="LauTokbokkiHud.uss" />
  <ui:VisualElement name="lauTokbokkiHud" class="app lau-tokbokki" picking-mode="Ignore">
    <ui:VisualElement name="field" class="field restaurant-floor" picking-mode="Ignore" />
    <ui:VisualElement name="stageLayer" class="app stage" picking-mode="Ignore">
      <ui:VisualElement name="floorDrawing" class="app" picking-mode="Ignore" />
      <ui:VisualElement name="cardLayer" class="app" picking-mode="Ignore" />
      <ui:VisualElement name="potLayer" class="app" picking-mode="Ignore" />
      <ui:VisualElement name="floorItemLayer" class="app" picking-mode="Ignore" />
      <ui:VisualElement name="tableLayer" class="app" picking-mode="Ignore" />
      <ui:VisualElement name="playerLayer" class="app" picking-mode="Ignore" />
      <ui:VisualElement name="feedbackLayer" class="app" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement name="seatLayer" class="safe-area" picking-mode="Ignore" />
    <ui:Label name="timer" class="timer" picking-mode="Ignore" />
    <ui:Label name="centerMessage" class="center-message" picking-mode="Ignore" />
    <ui:Label name="hint" class="hint" text="Chạm cần để trộm hoặc bỏ vào nồi" picking-mode="Ignore" />
    <ui:Button name="togglePlayers" class="btn toggle-players" />
    <ui:Instance template="ResultsOverlay" class="app" picking-mode="Ignore" />
    <ui:Instance template="PauseOverlay" class="app" picking-mode="Ignore" />
  </ui:VisualElement>
</ui:UXML>
