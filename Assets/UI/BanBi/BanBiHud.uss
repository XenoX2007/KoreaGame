/* The circle, marbles, hand, button and side columns are sized and placed by BanBiGame from the
   stage height; this file keeps only their look. */
.zone {
    position: absolute;
    left: 0;
    top: 0;
    border-width: 12px;
    border-color: var(--ink);
    background-color: #EBD7A8;
}

/* Chalk dots where the start marbles lie, shown during the dice roll. */
.start-dot {
    position: absolute;
    left: -3px;
    top: -3px;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(59, 42, 26, 0.3);
}

.marble {
    position: absolute;
    left: 0;
    top: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Each team's marble carries its flag: Vietnam blue with the star, Korea red with the taegeuk. */
.marble--vn {
    background-image: url("project://database/Assets/UI%20Assets/VN%20(Blue).png?fileID=-6213919199924930305&guid=57b60c2b2a3385b499ecd1327277332c&type=3#VN");
}

.marble--kr {
    background-image: url("project://database/Assets/UI%20Assets/KR%20(Red).png?fileID=-7028137374346497254&guid=09fb73fde01c8f04ab5df83bc9112a81&type=3#KR");
}

.marble-shadow {
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(59, 42, 26, 0.35);
}

.aim-dot {
    position: absolute;
    left: -7px;
    top: -7px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--ink);
}

.aim-dot.is-over {
    opacity: 0.3;
}

/* A point at the fingertips, placed by BanBiGame; the arm hangs below it, off the screen. */
.hand {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

/* The arm slices hang down with the hand at the bottom, so turn them to point up at the circle. */
.hand-sprite {
    position: absolute;
    left: -49px;
    top: 0;
    width: 98px;
    height: 260px;
    rotate: 180deg;
    -unity-background-scale-mode: scale-to-fit;
}

.hand--vn .hand-sprite {
    background-image: url("project://database/Assets/UI%20Assets/VN.png?fileID=-6036082917614504933&guid=d13124b112030db41982b2b230b54c3b&type=3#VN_4");
}

.hand--kr .hand-sprite {
    background-image: url("project://database/Assets/UI%20Assets/KR.png?fileID=451867275354555222&guid=b100521414c4d154695387eb5f702911&type=3#KR_3");
}

.hand-shadow {
    translate: 8px 8px;
    opacity: 0.4;
    -unity-background-image-tint-color: #000000;
}

/* The shared shoot button, in the active team's color with the .btn edge. */
.shoot-button {
    position: absolute;
    left: 0;
    top: 0;
    align-items: center;
    justify-content: center;
    border-bottom-width: 10px;
    background-color: #E5383B;
    border-bottom-color: #A8262A;
    transition-property: translate, opacity;
    transition-duration: 90ms, 200ms;
}

.shoot-button--vn {
    background-color: #2B6CF6;
    border-bottom-color: #1A47A8;
}

.shoot-button.is-pressed {
    border-bottom-width: 4px;
}

.shoot-button.is-disabled {
    opacity: 0.45;
}

.shoot-button__icon {
    width: 44px;
    height: 44px;
    background-image: url("project://database/Assets/UI/Art/icon-thumb.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.shoot-button__label {
    margin: 0;
    padding: 0;
    font-size: 36px;
    color: var(--paper);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

.shoot-button__name {
    position: absolute;
    bottom: -22px;
    width: 72px;
    height: 40px;
    margin: 0;
    padding: 0;
    border-radius: 20px;
    border-width: 3px;
    border-color: var(--paper);
    background-color: var(--ink);
    font-size: 24px;
    color: var(--paper);
    -unity-text-align: middle-center;
}

/* In the side strips, placed by BanBiGame. */
.team-count {
    position: absolute;
    left: 0;
    top: 0;
    width: 170px;
    height: 70px;
    margin: -35px 0 0 -85px;
    padding: 0;
    border-radius: 35px;
    font-size: 36px;
    color: var(--paper);
    -unity-text-align: middle-center;
}

.team-count--vn {
    background-color: #2B6CF6;
}

.team-count--kr {
    background-color: #E5383B;
}

/* Under the active team's counter, placed by BanBiGame (left/top = its top center).
   Height must match TurnRowHeight in BanBiGame.cs. */
.turn-row {
    position: absolute;
    left: 0;
    top: 0;
    height: 100px;
    flex-direction: row;
    align-items: center;
    translate: -50% 0;
}

.turn-label {
    height: 88px;
    margin: 0;
    padding: 0 28px;
    border-radius: 44px;
    background-color: var(--paper);
    font-size: 46px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

/* The countdown: a bigger round pill beside the turn count. */
.ban-bi .timer {
    position: relative;
    left: auto;
    top: auto;
    width: 100px;
    height: 100px;
    margin: 0 0 0 12px;
    border-radius: 50px;
    border-width: 5px;
    border-color: var(--ink);
    font-size: 64px;
}

.hint {
    position: absolute;
    left: 0;
    top: 0;
    width: 240px;
    margin: 0 0 0 -120px;
    padding: 0;
    font-size: 26px;
    white-space: normal;
    color: var(--paper);
    -unity-text-align: upper-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
}

/* Placeholder die above the seat disc (TODO(art): Die.png faces). */
.die {
    position: absolute;
    left: 45px;
    top: -112px;
    width: 80px;
    height: 80px;
    margin: 0;
    padding: 0;
    border-radius: 16px;
    border-width: 5px;
    border-color: var(--ink);
    background-color: var(--paper);
    font-size: 50px;
    -unity-text-align: middle-center;
}

.die.is-stopped {
    border-color: var(--gold-deep);
    background-color: var(--gold);
}

.seat--duel .die {
    left: 185px;
    top: 45px;
}

.order-badge {
    position: absolute;
    right: -8px;
    top: -8px;
    width: 56px;
    height: 56px;
    margin: 0;
    padding: 0;
    border-radius: 28px;
    border-width: 4px;
    border-color: var(--paper);
    background-color: var(--ink);
    color: var(--paper);
    font-size: 30px;
    -unity-text-align: middle-center;
}

.seat.is-waiting .seat-disc {
    opacity: 0.5;
}

/* The circle covers the top center, so the pause button moves to the top-left strip,
   clear of a notch and of the 4-player top-left seat. */
.ban-bi .pause-button {
    left: 5%;
    margin: 0;
}
