<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Template src="../ResultsOverlay.uxml" name="ResultsOverlay" />
  <ui:Style src="NguoiGoHud.uss" />
  <ui:VisualElement name="nguoiGoHud" class="app nguoi-go" picking-mode="Ignore">
    <ui:VisualElement name="field" class="field nguoi-go-field" picking-mode="Ignore" />
    <ui:VisualElement class="app stage" picking-mode="Ignore">
      <ui:VisualElement name="lanes" class="app" picking-mode="Ignore" />
      <ui:VisualElement name="callerRing" class="caller-ring" picking-mode="Ignore" />
      <ui:VisualElement name="caller" class="caller" picking-mode="Ignore" />
      <ui:VisualElement name="runnerLayer" class="app" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement name="seatLayer" class="safe-area" picking-mode="Ignore" />
    <ui:Label name="timer" class="timer" picking-mode="Ignore" />
    <ui:Label name="centerMessage" class="center-message" picking-mode="Ignore" />
    <ui:Button name="togglePlayers" class="btn toggle-players" />
    <ui:Instance template="ResultsOverlay" class="app" picking-mode="Ignore" />
  </ui:VisualElement>
</ui:UXML>
