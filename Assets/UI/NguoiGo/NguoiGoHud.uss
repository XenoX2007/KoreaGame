/* The feet stand at 72% of the stage: this must match CallerGround in NguoiGoGame.cs. */
.caller {
    position: absolute;
    left: 50%;
    top: 72%;
    width: 170px;
    height: 540px;
    margin-left: -85px;
    margin-top: -540px;
    transform-origin: 50% 100%;
    background-image: url("project://database/Assets/UI%20Assets/NPC_back.png");
    -unity-background-scale-mode: scale-to-fit;
}

.caller.is-watching {
    background-image: url("project://database/Assets/UI%20Assets/NPC.png");
}

.nguoi-go .seat-ring {
    opacity: 0.8;
    scale: 1.14 1.14;
}

/* The whole chant builds up here, so it needs more room than a single syllable. */
.nguoi-go .seat-chant {
    left: -165px;
    width: 500px;
    font-size: 42px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--paper);
}

.nguoi-go .seat--duel .seat-chant {
    left: 65px;
}

.nguoi-go .seat--duel .seat-feedback {
    left: 115px;
}
