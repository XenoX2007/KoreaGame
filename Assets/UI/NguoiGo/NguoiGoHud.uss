.nguoi-go-field {
    background-image: url("project://database/Assets/UI/Art/nguoigo-field.svg");
}

.caller-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 300px;
    height: 300px;
    margin-left: -150px;
    margin-top: -150px;
    border-radius: 150px;
    border-width: 12px;
    border-color: var(--jade);
    background-color: rgba(252, 244, 227, 0.75);
    transition-property: border-color, background-color;
    transition-duration: 120ms;
}

.caller-ring.is-watching {
    border-color: var(--rose);
    background-color: rgba(214, 51, 108, 0.28);
}

.caller {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 240px;
    height: 240px;
    margin-left: -120px;
    margin-top: -120px;
    background-image: url("project://database/Assets/UI/Art/caller-vn-covered.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.caller.is-watching {
    background-image: url("project://database/Assets/UI/Art/caller-vn-watching.svg");
}

.caller.is-korean {
    background-image: url("project://database/Assets/UI/Art/caller-kr-covered.svg");
}

.caller.is-korean.is-watching {
    background-image: url("project://database/Assets/UI/Art/caller-kr-watching.svg");
}

/* 88px must match RunnerSize in NguoiGoGame.cs. */
.runner {
    position: absolute;
    left: 0;
    top: 0;
    width: 88px;
    height: 88px;
    border-radius: 44px;
    border-width: 5px;
    border-color: var(--paper);
    background-color: var(--player);
    align-items: center;
    justify-content: center;
}

.runner Label {
    margin: 0;
    padding: 0;
    font-size: 30px;
}

.nguoi-go .seat-ring {
    opacity: 0.8;
    scale: 1.14 1.14;
}

/* The whole chant builds up here, so it needs more room than a single syllable. */
.nguoi-go .seat-chant {
    left: -165px;
    width: 500px;
    font-size: 42px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--paper);
}

.nguoi-go .seat--duel .seat-chant {
    left: 65px;
}

.nguoi-go .seat--duel .seat-feedback {
    left: 115px;
}
