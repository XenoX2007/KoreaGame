.menu-bg {
    position: absolute;
    left: -4px;
    right: -4px;
    top: -4px;
    bottom: -4px;
    background-image: url("project://database/Assets/UI%20Assets/BACKGROUND.png");
    -unity-background-scale-mode: scale-and-crop;
}

.menu {
    flex-grow: 1;
    padding: 28px 56px 32px 56px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
}

.menu.is-in {
    opacity: 1;
}

.menu-header {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
    align-items: flex-start;
}

.title {
    font-size: 128px;
    height: 168px;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

.subtitle {
    font-size: 40px;
    height: 56px;
    margin: -8px 0 0 6px;
    padding: 0;
    color: var(--rose-deep);
}

.picker {
    align-items: flex-end;
}

.picker-label {
    font-size: 32px;
    height: 46px;
    margin: 0 8px 10px 0;
    padding: 0;
}

.picker-options {
    flex-direction: row;
}

.seat-option {
    width: 188px;
    height: 170px;
    margin-left: 14px;
    padding: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.6;
    scale: 0.86 0.86;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: translate, scale, opacity;
    transition-duration: 90ms, 160ms, 160ms;
}

.seat-option--two {
    background-image: url("project://database/Assets/UI%20Assets/Group%201(1).png");
}

.seat-option--four {
    background-image: url("project://database/Assets/UI%20Assets/Group%202.png");
}

.seat-option.is-selected {
    opacity: 1;
    scale: 1 1;
}

.cards {
    flex-direction: row;
    flex-shrink: 0;
    height: 340px;
}

.game-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 9px;
    padding: 14px 14px 16px 14px;
    align-items: center;
    justify-content: center;
    border-top-width: 14px;
    opacity: 0;
    translate: 0 48px;
    transition-property: opacity, translate, scale;
    transition-duration: 320ms, 420ms, 90ms;
    transition-timing-function: ease-out, ease-out-back, ease;
}

.game-card--first {
    border-top-color: var(--rose);
    transition-delay: 60ms, 60ms, 0s;
}

.game-card--second {
    border-top-color: var(--gold);
    transition-delay: 150ms, 150ms, 0s;
}

.game-card--third {
    border-top-color: var(--jade);
    transition-delay: 240ms, 240ms, 0s;
}

.game-card--fourth {
    border-top-color: var(--p2);
    transition-delay: 330ms, 330ms, 0s;
}

.game-card--fifth {
    border-top-color: #C98321;
    transition-delay: 420ms, 420ms, 0s;
}

.game-card--sixth {
    border-top-color: #C8321F;
    transition-delay: 510ms, 510ms, 0s;
}

.is-in .game-card {
    opacity: 1;
    translate: 0 0;
}

.is-soon .card-icon {
    opacity: 0.6;
}

.is-soon .card-name {
    color: var(--wood);
}

.is-in .game-card:active {
    translate: 0 5px;
}

/* Six cards share the row, so the longest names (English) must still fit on one line. */
.card-name {
    font-size: 30px;
    height: 60px;
    margin: 2px 0 0 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.card-story {
    font-size: 19px;
    height: 58px;
    margin: 2px 0 0 0;
    padding: 0;
    color: var(--wood);
    white-space: normal;
    -unity-text-align: middle-center;
}

.card-korean {
    font-size: 24px;
    height: 40px;
    margin: 4px 0 0 0;
    padding: 0;
    color: var(--rose-deep);
    -unity-text-align: middle-center;
}

.card-badge {
    display: none;
    position: absolute;
    top: 14px;
    right: 16px;
    margin: 0;
    padding: 4px 16px;
    border-radius: 16px;
    background-color: var(--ink);
    color: var(--paper);
    font-size: 24px;
}

.is-soon .card-badge {
    display: flex;
}

.tournament {
    flex-direction: row;
    height: 92px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    margin: 18px 12px 0 12px;
    padding: 12px 40px;
}

.tournament:disabled {
    background-color: #7E9C94;
    border-bottom-color: #62807A;
}

.tournament-cup {
    width: 76px;
    height: 110px;
    flex-shrink: 0;
    margin-right: 20px;
    background-image: url("project://database/Assets/UI%20Assets/Trophy%20Cup%20%E2%80%93%20VN%20x%20KR.png?fileID=4842163755836273828&guid=957f1ecdb1c075141ba7636f88b479c4&type=3");
    -unity-background-scale-mode: scale-to-fit;
}

.tournament__title {
    font-size: 44px;
    margin: 0 24px 0 0;
    padding: 0;
    color: var(--paper);
}

.tournament__sub {
    font-size: 28px;
    margin: 0;
    padding: 0;
    color: var(--paper);
}

/* Centered between the title and the player picker. */
.language-button {
    position: absolute;
    left: 50%;
    top: 0;
    width: 180px;
    height: 170px;
    margin-left: -90px;
    padding: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
}

.language-globe {
    width: 112px;
    height: 112px;
    background-image: url("project://database/Assets/UI%20Assets/Language%20Globe.png");
    -unity-background-scale-mode: scale-to-fit;
}

.language-name {
    margin: 4px 0 0 0;
    padding: 2px 16px;
    border-radius: 18px;
    background-color: var(--paper);
    font-size: 26px;
    -unity-text-align: middle-center;
}

.language-card {
    width: 1180px;
}

.language-title {
    margin-bottom: 24px;
}

.language-option {
    width: 320px;
    background-color: var(--paper-edge);
    border-bottom-color: #C9B07F;
}

.language-option.btn--primary {
    background-color: var(--jade);
    border-bottom-color: var(--jade-deep);
}

/* Under the globe, between the title and the player picker. */
.online-button {
    position: absolute;
    left: 50%;
    top: 186px;
    width: 340px;
    height: 84px;
    margin-left: -170px;
    padding: 0;
    font-size: 34px;
}

.online-card {
    width: 1220px;
}

.online-title {
    height: 112px;
}

.online-status {
    height: 48px;
    margin: 0 0 16px 0;
    padding: 0;
    font-size: 30px;
    color: var(--wood);
    -unity-text-align: middle-center;
}

.online-section {
    display: none;
    align-items: center;
}

.online-code-label {
    margin: 0;
    padding: 0;
    font-size: 28px;
    color: var(--wood);
}

.online-code {
    margin: 0 0 12px 0;
    padding: 0;
    font-size: 96px;
    letter-spacing: 10px;
    white-space: nowrap;
    color: var(--rose-deep);
}

.online-slots {
    flex-direction: row;
    margin-bottom: 26px;
}

.online-slot {
    width: 96px;
    height: 96px;
    margin: 0 10px;
    border-radius: 48px;
    background-color: var(--player);
    color: var(--paper);
    font-size: 36px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

/* A seat nobody has taken yet. */
.online-slot.is-empty {
    opacity: 0.25;
}

/* The host picks the game here; the others see which one. */
.online-games {
    flex-direction: row;
    margin-bottom: 24px;
}

.online-game {
    width: 172px;
    height: 72px;
    margin: 0 4px;
    padding: 0 4px;
    font-size: 23px;
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: var(--paper-edge);
    border-bottom-color: #C9B07F;
}

.online-game.is-selected {
    background-color: var(--jade);
    border-bottom-color: var(--jade-deep);
    color: var(--paper);
}

/* Joining phones can't change the pick. */
.online-game:disabled {
    opacity: 0.5;
}

.online-game.is-selected:disabled {
    opacity: 1;
}

.online-action {
    width: 330px;
    height: 96px;
    padding: 0;
    margin: 0 12px;
}

.online-action:disabled {
    opacity: 0.45;
}

.online-close {
    margin-top: 26px;
    height: 76px;
    width: 300px;
    padding: 0;
    font-size: 32px;
    background-color: var(--paper-edge);
    border-bottom-color: #C9B07F;
}

.code-field {
    width: 560px;
    margin: 0 0 24px 0;
}

.code-field .unity-base-text-field__input {
    height: 110px;
    padding: 0 24px;
    border-width: 4px;
    border-radius: 26px;
    border-color: var(--paper-edge);
    background-color: #FFFFFF;
    color: var(--ink);
    font-size: 64px;
    letter-spacing: 12px;
    -unity-text-align: middle-center;
    --unity-cursor-color: var(--ink);
    --unity-selection-color: rgba(31, 122, 109, 0.3);
}

.code-field:focus .unity-base-text-field__input {
    border-color: var(--jade);
}

/* Cup screen (docs/CupSelect.html): a full-screen panel over the menu. */
.cup-panel {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #F8D98A;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 220ms;
}

.cup-panel.is-in {
    opacity: 1;
}

.cup-screen {
    flex-grow: 1;
    padding: 36px 60px 16px 60px;
}

.cup-top {
    flex-direction: row;
    flex-shrink: 0;
    height: 120px;
    align-items: center;
    justify-content: space-between;
}

.cup-back {
    width: 112px;
    height: 112px;
    margin: 0;
    padding: 30px 34px 30px 26px;
    border-width: 6px;
    border-radius: 56px;
    border-color: var(--paper-edge);
    background-color: #FFFBF2;
    color: var(--ink);
}

.cup-back:active {
    scale: 0.94 0.94;
}

.cup-back-arrow {
    flex-grow: 1;
}

.cup-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 72px;
    -unity-text-align: middle-center;
}

.cup-players {
    width: 232px;
    height: 80px;
    margin: 0;
    padding: 0;
    border-width: 4px;
    border-radius: 40px;
    border-color: var(--paper-edge);
    background-color: #FFFBF2;
    font-size: 38px;
    -unity-text-align: middle-center;
}

.cup-body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 24px;
    min-height: 0;
}

.cup-cards {
    width: 440px;
    flex-shrink: 1;
}

.cup-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 4px;
    border-bottom-width: 24px;
    border-radius: 44px;
    border-color: var(--paper-edge);
    background-color: #FFFBF2;
    color: var(--ink);
    transition-property: scale, background-color, border-color;
    transition-duration: 90ms, 160ms, 160ms;
}

.cup-card--mini {
    margin-bottom: 40px;
}

.cup-card:active {
    scale: 0.97 0.97;
}

.cup-card.is-selected {
    border-width: 10px;
    border-bottom-width: 24px;
    border-color: var(--gold-deep);
    background-color: #FCEBC0;
}

.cup-card.is-soon {
    opacity: 0.45;
}

.cup-card-icon {
    width: 140px;
    height: 120px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI%20Assets/Trophy%20Cup%20%E2%80%93%20VN%20x%20KR.png?fileID=4842163755836273828&guid=957f1ecdb1c075141ba7636f88b479c4&type=3");
    -unity-background-scale-mode: scale-to-fit;
}

.cup-card--grand .cup-card-icon {
    height: 186px;
}

.cup-card-name {
    margin: 10px 0 0 0;
    padding: 0;
    font-size: 52px;
    -unity-text-align: middle-center;
}

.cup-card-sub {
    margin: 0;
    padding: 0;
    font-size: 30px;
    color: var(--wood);
    -unity-text-align: middle-center;
}

/* 3 x 2 game tiles, built in code from CupPicker.AllGames. */
.cup-grid {
    width: 798px;
    flex-shrink: 1;
    margin-left: 40px;
    justify-content: space-between;
}

.cup-grid-row {
    flex-direction: row;
    height: 47.5%;
    justify-content: space-between;
}

.cup-tile {
    width: 31.5%;
    margin: 0;
    padding: 24px 10px 12px 10px;
    align-items: center;
    border-width: 4px;
    border-radius: 36px;
    border-color: var(--paper-edge);
    background-color: #FFFBF2;
    color: var(--ink);
    transition-property: scale;
    transition-duration: 90ms;
}

.cup-tile:active {
    scale: 0.97 0.97;
}

/* The thicker border is taken out of the padding, so the content doesn't move. */
.cup-tile.is-picked {
    padding: 20px 6px 8px 6px;
    border-width: 8px;
    border-color: var(--rose);
}

.cup-tile.is-soon {
    opacity: 0.4;
}

.cup-tile .card-icon {
    width: 150px;
    height: 150px;
    margin-bottom: 8px;
}

.cup-tile-name {
    margin: 0;
    padding: 0;
    font-size: 36px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.cup-tile-korean {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 26px;
    color: var(--wood);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* The dice's hop ring, a little outside the tile. */
.cup-tile-ring {
    display: none;
    position: absolute;
    left: -18px;
    right: -18px;
    top: -18px;
    bottom: -18px;
    border-width: 10px;
    border-radius: 50px;
    border-color: var(--gold);
}

.cup-tile.is-hop .cup-tile-ring {
    display: flex;
}

.cup-badge {
    display: none;
    position: absolute;
    top: -14px;
    right: -14px;
    width: 76px;
    height: 76px;
    margin: 0;
    padding: 0;
    border-width: 8px;
    border-radius: 38px;
    border-color: var(--paper);
    background-color: var(--rose);
    color: #FFFFFF;
    font-size: 40px;
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 260ms;
    transition-timing-function: ease-out-back;
}

.cup-badge.is-new {
    scale: 0.3 0.3;
}

.cup-side {
    flex-grow: 1;
    margin-left: 40px;
    align-items: center;
}

.cup-dice {
    width: 288px;
    height: 288px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 6px;
    border-radius: 144px;
    border-color: var(--paper-edge);
    background-color: #FFFBF2;
    transition-property: scale;
    transition-duration: 90ms;
}

.cup-dice:active {
    scale: 0.95 0.95;
}

.cup-die {
    width: 160px;
    height: 160px;
    border-width: 10px;
    border-radius: 32px;
    border-color: var(--ink);
    background-color: #FFFFFF;
    rotate: -12deg;
}

/* Pip centers at 30, 70 and 110 px inside the die's border. */
.cup-pip {
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: var(--rose);
}

.cup-pip--0, .cup-pip--1, .cup-pip--2 { top: 16px; }
.cup-pip--3, .cup-pip--4, .cup-pip--5 { top: 56px; }
.cup-pip--6, .cup-pip--7, .cup-pip--8 { top: 96px; }
.cup-pip--0, .cup-pip--3, .cup-pip--6 { left: 16px; }
.cup-pip--1, .cup-pip--4, .cup-pip--7 { left: 56px; }
.cup-pip--2, .cup-pip--5, .cup-pip--8 { left: 96px; }

.cup-dice-label {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 40px;
    -unity-text-align: middle-center;
}

/* The play order: small icons with arrows between them. */
/* Takes the room between the dice and Bắt đầu. */
.cup-order {
    flex-grow: 1;
    flex-direction: row;
    min-height: 80px;
    align-items: center;
    justify-content: center;
}

.cup-order .card-icon {
    width: 68px;
    height: 68px;
}

.cup-order-arrow {
    width: 16px;
    height: 26px;
    margin: 0 8px;
    color: var(--wood);
}

.cup-order--six .card-icon {
    width: 52px;
    height: 52px;
}

.cup-order--six .cup-order-arrow {
    width: 12px;
    height: 20px;
    margin: 0 4px;
}

.cup-start {
    width: 400px;
    height: 156px;
    padding: 0;
    border-bottom-width: 24px;
    border-radius: 52px;
    background-color: var(--rose);
    border-bottom-color: var(--rose-deep);
    color: #FFFFFF;
    font-size: 60px;
}

.cup-start:disabled {
    opacity: 0.45;
}

.cup-hint {
    flex-shrink: 0;
    height: 64px;
    margin: 0;
    padding: 0;
    font-size: 32px;
    color: var(--wood);
    -unity-text-align: middle-center;
}
