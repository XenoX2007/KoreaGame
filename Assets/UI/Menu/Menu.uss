.menu-bg {
    position: absolute;
    left: -4px;
    right: -4px;
    top: -4px;
    bottom: -4px;
    background-image: url("project://database/Assets/UI%20Assets/BACKGROUND.png");
    -unity-background-scale-mode: scale-and-crop;
}

.menu {
    flex-grow: 1;
    padding: 28px 56px 32px 56px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
}

.menu.is-in {
    opacity: 1;
}

.menu-header {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
    align-items: flex-start;
}

.title {
    font-size: 128px;
    height: 168px;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

.subtitle {
    font-size: 40px;
    height: 56px;
    margin: -8px 0 0 6px;
    padding: 0;
    color: var(--rose-deep);
}

.picker {
    align-items: flex-end;
}

.picker-label {
    font-size: 32px;
    height: 46px;
    margin: 0 8px 10px 0;
    padding: 0;
}

.picker-options {
    flex-direction: row;
}

.seat-option {
    width: 188px;
    height: 170px;
    margin-left: 14px;
    padding: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.6;
    scale: 0.86 0.86;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: translate, scale, opacity;
    transition-duration: 90ms, 160ms, 160ms;
}

.seat-option--two {
    background-image: url("project://database/Assets/UI%20Assets/Group%201(1).png");
}

.seat-option--four {
    background-image: url("project://database/Assets/UI%20Assets/Group%202.png");
}

.seat-option.is-selected {
    opacity: 1;
    scale: 1 1;
}

.cards {
    flex-direction: row;
    flex-shrink: 0;
    height: 340px;
}

.game-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 12px;
    padding: 14px 24px 16px 24px;
    align-items: center;
    justify-content: center;
    border-top-width: 14px;
    opacity: 0;
    translate: 0 48px;
    transition-property: opacity, translate, scale;
    transition-duration: 320ms, 420ms, 90ms;
    transition-timing-function: ease-out, ease-out-back, ease;
}

.game-card--first {
    border-top-color: var(--rose);
    transition-delay: 60ms, 60ms, 0s;
}

.game-card--second {
    border-top-color: var(--gold);
    transition-delay: 150ms, 150ms, 0s;
}

.game-card--third {
    border-top-color: var(--jade);
    transition-delay: 240ms, 240ms, 0s;
}

.is-in .game-card {
    opacity: 1;
    translate: 0 0;
}

.is-soon .card-icon {
    opacity: 0.6;
}

.is-soon .card-name {
    color: var(--wood);
}

.is-in .game-card:active {
    translate: 0 5px;
}

.card-icon {
    width: 132px;
    height: 132px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.card-icon--rope {
    background-image: url("project://database/Assets/UI/Art/icon-rope.svg");
}

.card-icon--mugunghwa {
    background-image: url("project://database/Assets/UI/Art/icon-mugunghwa.svg");
}

.card-icon--shuttlecock {
    background-image: url("project://database/Assets/UI/Art/icon-shuttlecock.svg");
}

.card-name {
    font-size: 52px;
    height: 72px;
    margin: 2px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.card-story {
    font-size: 26px;
    height: 38px;
    margin: 2px 0 0 0;
    padding: 0;
    color: var(--wood);
    white-space: normal;
    -unity-text-align: middle-center;
}

.card-korean {
    font-size: 28px;
    height: 40px;
    margin: 4px 0 0 0;
    padding: 0;
    color: var(--rose-deep);
    -unity-text-align: middle-center;
}

.card-badge {
    display: none;
    position: absolute;
    top: 14px;
    right: 16px;
    margin: 0;
    padding: 4px 16px;
    border-radius: 16px;
    background-color: var(--ink);
    color: var(--paper);
    font-size: 24px;
}

.is-soon .card-badge {
    display: flex;
}

.tournament {
    flex-direction: row;
    height: 92px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    margin: 18px 12px 0 12px;
    padding: 12px 40px;
}

.tournament:disabled {
    background-color: #7E9C94;
    border-bottom-color: #62807A;
}

.tournament-cup {
    width: 76px;
    height: 110px;
    flex-shrink: 0;
    margin-right: 20px;
    background-image: url("project://database/Assets/UI%20Assets/Trophy%20Cup%20%E2%80%93%20VN%20x%20KR.png?fileID=4842163755836273828&guid=957f1ecdb1c075141ba7636f88b479c4&type=3");
    -unity-background-scale-mode: scale-to-fit;
}

.tournament__title {
    font-size: 44px;
    margin: 0 24px 0 0;
    padding: 0;
    color: var(--paper);
}

.tournament__sub {
    font-size: 28px;
    margin: 0;
    padding: 0;
    color: var(--paper);
}
