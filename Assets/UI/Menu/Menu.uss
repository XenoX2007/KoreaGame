.menu-bg {
    position: absolute;
    left: -4px;
    right: -4px;
    top: -4px;
    bottom: -4px;
    background-image: url("project://database/Assets/UI%20Assets/BACKGROUND.png");
    -unity-background-scale-mode: scale-and-crop;
}

.menu {
    flex-grow: 1;
    padding: 28px 56px 32px 56px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
}

.menu.is-in {
    opacity: 1;
}

.menu-header {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
    align-items: flex-start;
}

.title {
    font-size: 128px;
    height: 168px;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

.subtitle {
    font-size: 40px;
    height: 56px;
    margin: -8px 0 0 6px;
    padding: 0;
    color: var(--rose-deep);
}

.picker {
    align-items: flex-end;
}

.picker-label {
    font-size: 32px;
    height: 46px;
    margin: 0 8px 10px 0;
    padding: 0;
}

.picker-options {
    flex-direction: row;
}

.seat-option {
    width: 188px;
    height: 170px;
    margin-left: 14px;
    padding: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.6;
    scale: 0.86 0.86;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: translate, scale, opacity;
    transition-duration: 90ms, 160ms, 160ms;
}

.seat-option--two {
    background-image: url("project://database/Assets/UI%20Assets/Group%201(1).png");
}

.seat-option--four {
    background-image: url("project://database/Assets/UI%20Assets/Group%202.png");
}

.seat-option.is-selected {
    opacity: 1;
    scale: 1 1;
}

.cards {
    flex-direction: row;
    flex-shrink: 0;
    height: 340px;
}

.game-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 12px;
    padding: 14px 24px 16px 24px;
    align-items: center;
    justify-content: center;
    border-top-width: 14px;
    opacity: 0;
    translate: 0 48px;
    transition-property: opacity, translate, scale;
    transition-duration: 320ms, 420ms, 90ms;
    transition-timing-function: ease-out, ease-out-back, ease;
}

.game-card--first {
    border-top-color: var(--rose);
    transition-delay: 60ms, 60ms, 0s;
}

.game-card--second {
    border-top-color: var(--gold);
    transition-delay: 150ms, 150ms, 0s;
}

.game-card--third {
    border-top-color: var(--jade);
    transition-delay: 240ms, 240ms, 0s;
}

.is-in .game-card {
    opacity: 1;
    translate: 0 0;
}

.is-soon .card-icon {
    opacity: 0.6;
}

.is-soon .card-name {
    color: var(--wood);
}

.is-in .game-card:active {
    translate: 0 5px;
}

.card-icon {
    width: 132px;
    height: 132px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.card-icon--rope {
    background-image: url("project://database/Assets/UI/Art/icon-rope.svg");
}

.card-icon--mugunghwa {
    background-image: url("project://database/Assets/UI/Art/icon-mugunghwa.svg");
}

.card-icon--shuttlecock {
    background-image: url("project://database/Assets/UI/Art/icon-shuttlecock.svg");
}

.card-name {
    font-size: 52px;
    height: 72px;
    margin: 2px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.card-story {
    font-size: 26px;
    height: 38px;
    margin: 2px 0 0 0;
    padding: 0;
    color: var(--wood);
    white-space: normal;
    -unity-text-align: middle-center;
}

.card-korean {
    font-size: 28px;
    height: 40px;
    margin: 4px 0 0 0;
    padding: 0;
    color: var(--rose-deep);
    -unity-text-align: middle-center;
}

.card-badge {
    display: none;
    position: absolute;
    top: 14px;
    right: 16px;
    margin: 0;
    padding: 4px 16px;
    border-radius: 16px;
    background-color: var(--ink);
    color: var(--paper);
    font-size: 24px;
}

.is-soon .card-badge {
    display: flex;
}

.tournament {
    flex-direction: row;
    height: 92px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    margin: 18px 12px 0 12px;
    padding: 12px 40px;
}

.tournament:disabled {
    background-color: #7E9C94;
    border-bottom-color: #62807A;
}

.tournament-cup {
    width: 76px;
    height: 110px;
    flex-shrink: 0;
    margin-right: 20px;
    background-image: url("project://database/Assets/UI%20Assets/Trophy%20Cup%20%E2%80%93%20VN%20x%20KR.png?fileID=4842163755836273828&guid=957f1ecdb1c075141ba7636f88b479c4&type=3");
    -unity-background-scale-mode: scale-to-fit;
}

.tournament__title {
    font-size: 44px;
    margin: 0 24px 0 0;
    padding: 0;
    color: var(--paper);
}

.tournament__sub {
    font-size: 28px;
    margin: 0;
    padding: 0;
    color: var(--paper);
}

/* Centered between the title and the player picker. */
.language-button {
    position: absolute;
    left: 50%;
    top: 0;
    width: 180px;
    height: 170px;
    margin-left: -90px;
    padding: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
}

.language-globe {
    width: 112px;
    height: 112px;
    background-image: url("project://database/Assets/UI%20Assets/Language%20Globe.png");
    -unity-background-scale-mode: scale-to-fit;
}

.language-name {
    margin: 4px 0 0 0;
    padding: 2px 16px;
    border-radius: 18px;
    background-color: var(--paper);
    font-size: 26px;
    -unity-text-align: middle-center;
}

.language-card {
    width: 1180px;
}

.language-title {
    margin-bottom: 24px;
}

.language-option {
    width: 320px;
    background-color: var(--paper-edge);
    border-bottom-color: #C9B07F;
}

.language-option.btn--primary {
    background-color: var(--jade);
    border-bottom-color: var(--jade-deep);
}

/* Under the globe, between the title and the player picker. */
.online-button {
    position: absolute;
    left: 50%;
    top: 186px;
    width: 340px;
    height: 84px;
    margin-left: -170px;
    padding: 0;
    font-size: 34px;
}

.online-card {
    width: 1220px;
}

.online-title {
    height: 112px;
}

.online-status {
    height: 48px;
    margin: 0 0 16px 0;
    padding: 0;
    font-size: 30px;
    color: var(--wood);
    -unity-text-align: middle-center;
}

.online-section {
    display: none;
    align-items: center;
}

.online-code-label {
    margin: 0;
    padding: 0;
    font-size: 28px;
    color: var(--wood);
}

.online-code {
    margin: 0 0 12px 0;
    padding: 0;
    font-size: 96px;
    letter-spacing: 10px;
    white-space: nowrap;
    color: var(--rose-deep);
}

.online-slots {
    flex-direction: row;
    margin-bottom: 26px;
}

.online-slot {
    width: 96px;
    height: 96px;
    margin: 0 10px;
    border-radius: 48px;
    background-color: var(--player);
    color: var(--paper);
    font-size: 36px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

/* A seat nobody has taken yet. */
.online-slot.is-empty {
    opacity: 0.25;
}

.online-action {
    width: 330px;
    height: 96px;
    padding: 0;
    margin: 0 12px;
}

.online-action:disabled {
    opacity: 0.45;
}

.online-close {
    margin-top: 26px;
    height: 76px;
    width: 300px;
    padding: 0;
    font-size: 32px;
    background-color: var(--paper-edge);
    border-bottom-color: #C9B07F;
}

.code-field {
    width: 560px;
    margin: 0 0 24px 0;
}

.code-field .unity-base-text-field__input {
    height: 110px;
    padding: 0 24px;
    border-width: 4px;
    border-radius: 26px;
    border-color: var(--paper-edge);
    background-color: #FFFFFF;
    color: var(--ink);
    font-size: 64px;
    letter-spacing: 12px;
    -unity-text-align: middle-center;
    --unity-cursor-color: var(--ink);
    --unity-selection-color: rgba(31, 122, 109, 0.3);
}

.code-field:focus .unity-base-text-field__input {
    border-color: var(--jade);
}
