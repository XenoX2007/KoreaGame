<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="Menu.uss" />
  <ui:VisualElement name="app" class="app">
    <ui:VisualElement class="menu-bg" picking-mode="Ignore" />
    <ui:VisualElement name="safeArea" class="safe-area" picking-mode="Ignore">
      <ui:VisualElement name="menu" class="menu" picking-mode="Ignore">
        <ui:VisualElement class="menu-header" picking-mode="Ignore">
          <ui:Button name="languageButton" class="btn language-button">
            <ui:VisualElement class="language-globe" picking-mode="Ignore" />
            <ui:Label name="languageName" class="language-name" picking-mode="Ignore" />
          </ui:Button>
          <ui:Button name="onlineButton" class="btn btn--accent online-button" text="Chơi online" />
          <ui:VisualElement class="title-block" picking-mode="Ignore">
            <ui:Label class="title" text="Sân Chơi" picking-mode="Ignore" />
            <ui:Label class="subtitle" text="마당 · Madang · 같이 놀자" picking-mode="Ignore" />
          </ui:VisualElement>
          <ui:VisualElement class="picker" picking-mode="Ignore">
            <ui:Label class="picker-label" text="Bao nhiêu người chơi?" picking-mode="Ignore" />
            <ui:VisualElement class="picker-options" picking-mode="Ignore">
              <ui:Button name="twoPlayers" class="btn seat-option seat-option--two" />
              <ui:Button name="fourPlayers" class="btn seat-option seat-option--four" />
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="cards" picking-mode="Ignore">
          <ui:Button name="cardNguoiGo" class="btn game-card game-card--first">
            <ui:VisualElement class="card-icon card-icon--mugunghwa" picking-mode="Ignore" />
            <ui:Label class="card-name" text="Người Gỗ" picking-mode="Ignore" />
            <ui:Label class="card-story" text="Hai trò khác tên, một luật chơi" picking-mode="Ignore" />
            <ui:Label class="card-korean" text="무궁화 꽃이 피었습니다" picking-mode="Ignore" />
            <ui:Label class="card-badge" text="Sắp có" picking-mode="Ignore" />
          </ui:Button>
          <ui:Button name="cardKeoCo" class="btn game-card game-card--second">
            <ui:VisualElement class="card-icon card-icon--rope" picking-mode="Ignore" />
            <ui:Label class="card-name" text="Kéo Co" picking-mode="Ignore" />
            <ui:Label class="card-story" text="Một di sản chung" picking-mode="Ignore" />
            <ui:Label class="card-korean" text="줄다리기" picking-mode="Ignore" />
            <ui:Label class="card-badge" text="Sắp có" picking-mode="Ignore" />
          </ui:Button>
          <ui:Button name="cardDaCau" class="btn game-card game-card--third">
            <ui:VisualElement class="card-icon card-icon--shuttlecock" picking-mode="Ignore" />
            <ui:Label class="card-name" text="Đá Cầu" picking-mode="Ignore" />
            <ui:Label class="card-story" text="Chơi cùng nhau, chuyền cầu cho nhau" picking-mode="Ignore" />
            <ui:Label class="card-korean" text="제기차기" picking-mode="Ignore" />
            <ui:Label class="card-badge" text="Sắp có" picking-mode="Ignore" />
          </ui:Button>
          <ui:Button name="cardBanBi" class="btn game-card game-card--fourth">
            <ui:VisualElement class="card-icon card-icon--marble" picking-mode="Ignore">
              <ui:VisualElement class="card-marble card-marble--vn" picking-mode="Ignore" />
              <ui:VisualElement class="card-marble card-marble--kr" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label class="card-name" text="Bắn Bi" picking-mode="Ignore" />
            <ui:Label class="card-story" text="Búng bi ra khỏi vòng" picking-mode="Ignore" />
            <ui:Label class="card-korean" text="구슬치기" picking-mode="Ignore" />
            <ui:Label class="card-badge" text="Sắp có" picking-mode="Ignore" />
          </ui:Button>
          <ui:Button name="cardTachKeo" class="btn game-card game-card--fifth">
            <ui:VisualElement class="card-icon card-icon--candy" picking-mode="Ignore" />
            <ui:Label class="card-name" text="Tách Kẹo" picking-mode="Ignore" />
            <ui:Label class="card-story" text="Tách hình kẹo mà không làm vỡ" picking-mode="Ignore" />
            <ui:Label class="card-korean" text="뽑기" picking-mode="Ignore" />
            <ui:Label class="card-badge" text="Sắp có" picking-mode="Ignore" />
          </ui:Button>
          <ui:Button name="cardLauTokbokki" class="btn game-card game-card--sixth">
            <ui:VisualElement class="card-icon card-icon--hotpot" picking-mode="Ignore" />
            <ui:Label class="card-name" text="Lẩu Tokbokki" picking-mode="Ignore" />
            <ui:Label class="card-story" text="Gom đủ món, nấu nồi lẩu hoàn hảo" picking-mode="Ignore" />
            <ui:Label class="card-korean" text="즉석떡볶이" picking-mode="Ignore" />
            <ui:Label class="card-badge" text="Sắp có" picking-mode="Ignore" />
          </ui:Button>
        </ui:VisualElement>
        <ui:Button name="tournament" class="btn btn--primary tournament">
          <ui:VisualElement class="tournament-cup" picking-mode="Ignore" />
          <ui:Label class="tournament__title" text="Giải đấu" picking-mode="Ignore" />
          <ui:Label class="tournament__sub" text="Chọn 3 hoặc 6 trò, tính điểm, lên bục vinh quang" picking-mode="Ignore" />
          <ui:Label class="card-badge" text="Sắp có" picking-mode="Ignore" />
        </ui:Button>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="languagePicker" class="results">
      <ui:VisualElement class="results-card language-card" picking-mode="Ignore">
        <ui:Label class="result-title language-title" text="Ngôn ngữ" picking-mode="Ignore" />
        <ui:VisualElement name="languageOptions" class="result-actions" picking-mode="Ignore" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="onlinePanel" class="results">
      <ui:VisualElement class="results-card online-card" picking-mode="Ignore">
        <ui:Label class="result-title online-title" text="Chơi online" picking-mode="Ignore" />
        <ui:Label name="onlineStatus" class="online-status" picking-mode="Ignore" />
        <ui:VisualElement name="onlineChoose" class="result-actions" picking-mode="Ignore">
          <ui:Button name="hostButton" class="btn btn--primary result-button" text="Tạo phòng" />
          <ui:Button name="joinButton" class="btn btn--accent result-button" text="Vào phòng" />
        </ui:VisualElement>
        <ui:VisualElement name="onlineJoin" class="online-section" picking-mode="Ignore">
          <ui:TextField name="codeField" class="code-field" max-length="10" />
          <ui:Button name="joinConfirmButton" class="btn btn--primary result-button" text="Vào" />
        </ui:VisualElement>
        <ui:VisualElement name="onlineRoom" class="online-section" picking-mode="Ignore">
          <ui:Label class="online-code-label" text="Mã phòng" picking-mode="Ignore" />
          <ui:Label name="roomCode" class="online-code" picking-mode="Ignore" />
          <ui:VisualElement name="onlineSlots" class="online-slots" picking-mode="Ignore" />
          <ui:VisualElement class="result-actions" picking-mode="Ignore">
            <ui:Button name="shareButton" class="btn btn--accent online-action" text="Chia sẻ" />
            <ui:Button name="copyButton" class="btn btn--accent online-action" text="Sao chép" />
            <ui:Button name="startButton" class="btn btn--primary online-action" text="Bắt đầu" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="onlineCloseButton" class="btn online-close" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="cupPanel" class="cup-panel">
      <ui:VisualElement name="cupSafeArea" class="safe-area" picking-mode="Ignore">
        <ui:VisualElement class="cup-screen" picking-mode="Ignore">
          <ui:VisualElement class="cup-top" picking-mode="Ignore">
            <ui:Button name="cupBack" class="cup-back" />
            <ui:Label class="cup-title" text="Chọn cúp" picking-mode="Ignore" />
            <ui:Label name="cupPlayers" class="cup-players" picking-mode="Ignore" />
          </ui:VisualElement>
          <ui:VisualElement class="cup-body" picking-mode="Ignore">
            <ui:VisualElement class="cup-cards" picking-mode="Ignore">
              <ui:Button name="cupMini" class="cup-card cup-card--mini">
                <ui:VisualElement class="cup-card-icon" picking-mode="Ignore" />
                <ui:Label class="cup-card-name" text="Cúp Nhỏ" picking-mode="Ignore" />
                <ui:Label class="cup-card-sub" text="3 trò · ~5 phút" picking-mode="Ignore" />
              </ui:Button>
              <ui:Button name="cupGrand" class="cup-card cup-card--grand">
                <ui:VisualElement class="cup-card-icon" picking-mode="Ignore" />
                <ui:Label class="cup-card-name" text="Cúp Lớn" picking-mode="Ignore" />
                <ui:Label class="cup-card-sub" text="6 trò · ~10 phút" picking-mode="Ignore" />
              </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="cupGrid" class="cup-grid" picking-mode="Ignore" />
            <ui:VisualElement class="cup-side" picking-mode="Ignore">
              <ui:Button name="cupDice" class="cup-dice">
                <ui:VisualElement name="cupDie" class="cup-die" picking-mode="Ignore" />
              </ui:Button>
              <ui:Label class="cup-dice-label" text="Tung xúc xắc" picking-mode="Ignore" />
              <ui:VisualElement name="cupOrder" class="cup-order" picking-mode="Ignore" />
              <ui:Button name="cupStart" class="btn cup-start" text="Bắt đầu" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:Label name="cupHint" class="cup-hint" picking-mode="Ignore" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
